# Environment variables for STsup (Self-hosted Agile/Kanban tracker)

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://stuser:stpassword@localhost:5432/stsup_db?schema=public"

# App settings
PORT=3000
NODE_ENV=development

# Authentication secret
NEXTAUTH_SECRET="stsup_super_secret_jwt_key_change_me_in_production"
NEXTAUTH_URL="http://localhost:3000"

# Uploads directory (relative to project root or absolute)
UPLOAD_DIR="./public/uploads"

# Optional future MCP / Confluence configuration
CONFLUENCE_MCP_SERVER_URL=""
CONFLUENCE_BASE_URL=""
CONFLUENCE_API_TOKEN=""

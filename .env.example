# Environment variables for STsup (Self-hosted Agile/Kanban tracker)

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://stuser:stpassword@localhost:5432/stsup_db?schema=public"

# App settings
PORT=3000
NODE_ENV=development

# Authentication & Default Admin
NEXTAUTH_SECRET="stsup_super_secret_jwt_key_change_me_in_production"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@stsup.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Євген"

# SMTP Email Configuration (Optional - without it, password reset link is displayed in UI / logged to console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"STsup" <no-reply@stsup.local>'

# Uploads directory (relative to project root or absolute)
UPLOAD_DIR="./public/uploads"

# Optional future MCP / Confluence configuration
CONFLUENCE_MCP_SERVER_URL=""
CONFLUENCE_BASE_URL=""
CONFLUENCE_API_TOKEN=""
